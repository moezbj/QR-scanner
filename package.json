{
  "name": "QR-scanner",
  "productName": "QR-scanner",
  "version": "1.0.0",
  "description": "My Electron application description",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "tsc && vite",
    "build:mac": "tsc && vite build && electron-builder",
    "build": "tsc && vite build",
    "build:32": "vite build && electron-builder --win --ia32",
    "build:64": "vite build && electron-builder --win --x64",
    "postinstall": "electron-builder install-app-deps",
    "build:win": "vite build && electron-builder --win --x64 --ia32",
    "lint": "eslint --ext .ts,.tsx ."
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/node": "^20.12.8",
    "@types/node-forge": "^1.3.11",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^9.1.2",
    "electron": "30.0.2",
    "electron-builder": "^25.1.8",
    "electron-rebuild": "^3.2.9",
    "eslint": "^8.0.1",
    "eslint-plugin-import": "^2.25.0",
    "postcss": "^8.4.38",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.3",
    "ts-node": "^10.0.0",
    "typescript": "^5.8.2",
    "vite": "^5.0.12",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vite-plugin-static-copy": "^2.3.0",
    "wait-on": "^8.0.3"
  },
  "keywords": [],
  "author": {
    "name": "Add your name here"
  },
  "license": "MIT",
  "dependencies": {
    "@radix-ui/react-slot": "^1.0.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/react-router-dom": "^5.3.3",
    "better-sqlite3": "^11.8.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "electron-squirrel-startup": "^1.0.0",
    "i18next": "^24.2.2",
    "i18next-browser-languagedetector": "^8.0.4",
    "i18next-http-backend": "^3.0.2",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.378.0",
    "node-forge": "^1.3.1",
    "qr-code-styling": "^1.9.1",
    "react-i18next": "^15.4.1",
    "react-icons": "^5.5.0",
    "react-qr-barcode-scanner": "^2.0.0",
    "react-router-dom": "^7.2.0",
    "tailwind-merge": "^2.3.0",
    "tailwindcss-animate": "^1.0.7",
    "vite-plugin-electron": "^0.29.0",
    "xlsx": "^0.18.5"
  },
  "build": {
    "appId": "com.example.electronapp",
    "productName": "QR-scanner",
    "directories": {
      "output": "release/${version}"
    },
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "!database/*",
      "!uploads/**/*",
      "!release/**/*"
    ],
    "extraResources": [
      "./node_modules/react-qr-barcode-scanner/**/*"
    ],
    "files": [
      "dist",
      "dist-electron",
      "public",
      "./entitlements.mac.plist"
    ],
    "win": {
      "certificateFile": "./win-certificate.p12",
      "certificatePassword": "Test123&",
      "signAndEditExecutable": false,
      "requestedExecutionLevel": "requireAdministrator",
      "publisherName": "moezbj",
      "icon": "src/assets/icons/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "ia32"
          ]
        }
      ],
      "extraFiles": [
        "manifest.xml"
      ],
      "artifactName": "${productName}-Windows-${version}-Setup.${ext}"
    },
    "extraFiles": [
      {
        "from": "node_modules/better-sqlite3/build/Release/better_sqlite3.node",
        "to": "resources/better_sqlite3.node"
      }
    ],
    "mac": {
      "icon": "src/assets/icons/icon.icns",
      "hardenedRuntime": false,
      "category": "public.app-category.utilities",
      "gatekeeperAssess": false,
      "entitlements": "./entitlements.mac.plist",
      "entitlementsInherit": "./entitlements.mac.plist",
      "extendInfo": {
        "NSCameraUsageDescription": "This app needs access to your camera to scan QR codes.",
        "NSMicrophoneUsageDescription": "Please give us access to your microphone",
        "com.apple.security.device.audio-input": true,
        "com.apple.security.device.camera": true
      },
      "target": "dmg"
    }
  }
}